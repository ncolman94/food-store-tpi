# Copiar como .env y completar. El .env no se sube al repositorio ni se entrega.

# PostgreSQL. Para desarrollo local tambien sirve SQLite: sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:completar@localhost:5432/foodstore_db

# Clave para firmar los JWT: al menos 32 caracteres aleatorios. Para generarla:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
